<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup 规则（API < 31 走本文件；31+ 走 data_extraction_rules.xml）。

  审计 2026-09-29：Manifest 曾声明 allowBackup="true" 但从未引用本文件，
  targetSdk 36 下磁力任务清单（filesDir/magnet/cache/.tasks.json，记录用户
  解析过的磁力链与保存路径）、设置（settings.preferences_pb，含代理配置）
  与引擎态（.meta/.resume/.dht_state）会被默认全量云备份——隐私泄露面。

  决策：**全排除**。备份里不留任何应用数据（等效 allowBackup=false，
  但保留接线点——将来要精细化备份时在这里加 <include>）。
  引擎态文件本就与设备会话绑定（fastresume 跨设备恢复无意义）。
-->
<full-backup-content>
    <exclude domain="file" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="sharedpref" path="."/>
</full-backup-content>
