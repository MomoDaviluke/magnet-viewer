<?xml version="1.0" encoding="utf-8"?>
<!--
  Data Extraction 规则（API 31+：云备份与设备迁移统一在此声明；
  API < 31 走 backup_rules.xml）。

  审计 2026-09-29：原先从未被 Manifest 引用（孤儿模板）。决策与
  backup_rules.xml 一致——**全排除**，磁力任务清单 / 设置 / 引擎态
  不进云备份、不随设备迁移，理由见 backup_rules.xml 头注释。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>
