# 虚拟环境（含此前损坏待手动删除的旧环境）
.venv/
.venv_old_broken/
venv/

# Python 字节码与打包产物（PyInstaller：build/ 中间件、dist/ 产物均不入库）
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/.installed

# 运行时日志
*.log

# 测试与覆盖率缓存
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# 编辑器与系统文件
.idea/
.vscode/
.DS_Store
Thumbs.db

# PyInstaller 产物
build/
dist/
*.spec
# 规范内的两份 spec 必须入库（release.yml 在 GitHub 上要靠它们复现构建）
!magnet-viewer.spec
!magnet-viewer-onefile.spec

# 根目录单文件 exe（打包产物）
/MagnetViewer.exe

.workbuddy/

# Hermes agent 工作目录（规划等临时产物）
.hermes/
